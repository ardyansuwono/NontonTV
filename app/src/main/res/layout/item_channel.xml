<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="catId"
            type="int" />
        <variable
            name="chId"
            type="int" />
        <variable
            name="modelChannel"
            type="id.tipime.tipistream.model.Channel" />
        <variable
            name="clickListener"
            type="id.tipime.tipistream.adapter.ChannelClickListener" />
    </data>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/channel_grid_spacing">

        <LinearLayout
            android:id="@+id/btn_play"
            android:layout_width="@dimen/btn_channel_width"
            android:layout_height="@dimen/btn_channel_height"
            android:background="@drawable/button_channel"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/btn_channel_padding"
            android:clickable="true"
            android:focusable="true"
            android:onClick="@{() -> clickListener.onClicked(modelChannel, catId, chId)}"
            android:onLongClick="@{() -> clickListener.onLongClicked(modelChannel, catId, chId)}"
            app:onFocusChangeListener="@{clickListener.onFocusChanged}">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                app:logoUrl="@{modelChannel.logoUrl}"
                tools:ignore="ContentDescription"
                tools:src="@drawable/logo_tipistream" />

            <TextView
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:text="@{modelChannel.name}"
                tools:text="DUMMY CHANNEL NAME" />

        </LinearLayout>
    </FrameLayout>
</layout>
